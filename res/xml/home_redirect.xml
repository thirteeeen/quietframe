<?xml version="1.0" encoding="utf-8"?>
<!-- Told which app's window opens (package and class names only), to spot the TV's home and to
     know what was on screen when the TV wakes. It cannot see key presses or read the screen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/redirect_description"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0" />
